# Configuration Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral:latest
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Configuration ChromaDB
CHROMA_PERSIST_DIRECTORY=./data/chroma
CHROMA_COLLECTION_NAME=gct_documents_v2

# Configuration Embeddings
EMBEDDING_MODEL=intfloat/multilingual-e5-small

# Configuration Authentification (locale, légère)
# true = l'auth est requise (/ask : token user ou admin ; /documents : admin)
AUTH_ENABLED=true
# Token administrateur (ingestion + chat). À changer pour un déploiement réel.
AUTH_ADMIN_TOKEN=
# Tokens utilisateur (chat uniquement), séparés par des virgules.
AUTH_USER_TOKENS=

# Configuration API
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# Configuration Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log

# Configuration RAG
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K_RETRIEVAL=5
