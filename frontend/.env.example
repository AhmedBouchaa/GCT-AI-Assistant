# URL de base de l'API (facultatif).
# Vide (défaut) = chemins relatifs /api gérés par un proxy :
#   - en développement : proxy Vite (vite.config.js -> http://127.0.0.1:8000)
#   - en Docker        : proxy nginx (frontend/Dockerfile + nginx.conf)
# Pour un backend direct SANS proxy, définir l'URL absolue :
# VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_API_BASE_URL=
